{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sxom11",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-22",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "ROOMS_DB"
    }
  ]
}
